<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign skip = "/404.html" %}{% for p in site.html_pages %}{% unless skip contains p.url %}  <url><loc>{{ p.url | absolute_url }}</loc></url>
